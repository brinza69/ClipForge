# ClipForge — example environment file.
#
# Copy to `.env.local` (frontend, read by Next) and/or export in the shell that
# starts the backend. NEVER commit a filled-in copy: `.gitignore` already
# excludes `.env*` and whitelists only this file.
#
# Every backend setting is a field on `server/config.py::Settings`, which uses
# the `CLIPFORGE_` prefix — so `max_concurrent_jobs` is `CLIPFORGE_MAX_CONCURRENT_JOBS`.
# Anything omitted falls back to the default shown here.
#
# No API keys belong in this file. ElevenLabs / OpenAI / Anthropic keys are
# entered in the Settings UI and stored encrypted under `data/` by
# `server/services/secret_storage.py`.


# ─── Frontend (Next.js) ───────────────────────────────────────────────────────

# Where the Next dev server proxies /worker-api/* . Must match the port uvicorn
# actually binds. Getting this wrong is the classic ClipForge failure: every
# /worker-api call returns an opaque 500 that reads "Internal Server Error".
WORKER_URL_INTERNAL=http://127.0.0.1:8420


# ─── Backend: server ──────────────────────────────────────────────────────────

CLIPFORGE_HOST=0.0.0.0
CLIPFORGE_PORT=8420
CLIPFORGE_DEBUG=false
# Heavy-lane concurrency (downloads, transcription, renders). The light lane for
# doodle/tiktok/clipper analysis jobs is separate and fixed at 2.
CLIPFORGE_MAX_CONCURRENT_JOBS=2
CLIPFORGE_ALLOWED_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000

# Absolute path to the directory holding ffmpeg/ffprobe. Blank = search PATH.
CLIPFORGE_FFMPEG_PATH=

# Everything the app writes (DB, media, exports, caches) lives under here.
# CLIPFORGE_DATA_DIR=D:\clipforge\data


# ─── Backend: transcription (faster-whisper) ─────────────────────────────────

# tiny | base | small | medium | large-v3. "medium" roughly halves WER on
# accented speech versus "small", at ~3x the time.
CLIPFORGE_WHISPER_MODEL=medium
# auto | cuda | cpu. NOTE: CUDA can silently fall back to CPU; /api/transcript/device
# reports what actually loaded.
CLIPFORGE_WHISPER_DEVICE=auto
CLIPFORGE_WHISPER_COMPUTE_TYPE=float16
# Long audio is split into chunks so peak RAM stays bounded. 0 disables chunking.
CLIPFORGE_WHISPER_CHUNK_DURATION_S=600
CLIPFORGE_WHISPER_CHUNK_MIN_DURATION_S=900


# ─── Backend: export defaults (remix / parallel pipelines) ───────────────────

CLIPFORGE_EXPORT_WIDTH=1080
CLIPFORGE_EXPORT_HEIGHT=1920
CLIPFORGE_EXPORT_FPS=30
CLIPFORGE_EXPORT_BITRATE=4000k
CLIPFORGE_EXPORT_CODEC=libx264
CLIPFORGE_EXPORT_AUDIO_CODEC=aac
CLIPFORGE_EXPORT_AUDIO_BITRATE=192k


# ─── Backend: Real-ESRGAN upscaler ───────────────────────────────────────────

# Blank = auto-detect at tools/realesrgan/pkg/realesrgan-ncnn-vulkan(.exe).
CLIPFORGE_REALESRGAN_PATH=
# CAUTION: the ncnn/Vulkan device order is REVERSED versus nvidia-smi on this
# rig — index 0 is the RTX 3060, index 1 the GTX 1660 Super.
CLIPFORGE_REALESRGAN_GPU_ID=0


# ─── Backend: AI Stream Clipper ──────────────────────────────────────────────

# Master switch. false leaves the code installed but registers neither the
# router nor the job handlers — the documented rollback lever.
CLIPFORGE_CLIPPER_ENABLED=true

# Ingestion limits. The duration cap stops one bad paste from filling the disk;
# the free-space check runs BEFORE the download starts, not after.
CLIPFORGE_CLIPPER_MAX_SOURCE_DURATION_S=43200      # 12 hours (full stream VODs)
CLIPFORGE_CLIPPER_MAX_UPLOAD_BYTES=21474836480     # 20 GB
CLIPFORGE_CLIPPER_MIN_FREE_BYTES=10737418240       # 10 GB

# The analysis proxy. EVERY analysis pass reads this instead of the original —
# it is what makes a multi-hour VOD tractable. Raising the width raises
# detection quality and cost together.
CLIPFORGE_CLIPPER_PROXY_WIDTH=480
CLIPFORGE_CLIPPER_PROXY_FPS=10
# Hard cap on sampled frames regardless of source length, so a 6-hour stream
# cannot turn into twenty thousand JPEGs.
CLIPFORGE_CLIPPER_MAX_SAMPLED_FRAMES=400

# Output shape. 15-45 s is the documented sweet spot for stream clips; the
# 90 s ceiling exists for explanations that genuinely need the room.
CLIPFORGE_CLIPPER_DEFAULT_CLIP_COUNT=8
CLIPFORGE_CLIPPER_MIN_CLIP_S=15
CLIPFORGE_CLIPPER_MAX_CLIP_S=90
CLIPFORGE_CLIPPER_TARGET_CLIP_S=35

# Duplicate removal. Raise either threshold to keep more near-identical clips.
CLIPFORGE_CLIPPER_OVERLAP_THRESHOLD=0.4
CLIPFORGE_CLIPPER_TEXT_SIMILARITY_THRESHOLD=0.62

# Pass D — the expensive multimodal review. Blank engine means the pass is
# SKIPPED entirely and headlines fall back to deterministic extraction, so the
# pipeline never fails just because an optional provider is missing.
# Valid values match the transcript-cleaner engines: ollama | openai | anthropic
CLIPFORGE_CLIPPER_LLM_ENGINE=
CLIPFORGE_CLIPPER_TOP_N_LLM=8

# Export. crf 18 + preset slow is the single quality pass — crop, scale, stack
# and caption burn are fused into ONE encode, so there is no second generation
# of compression loss to save bits for.
CLIPFORGE_CLIPPER_EXPORT_CRF=18
CLIPFORGE_CLIPPER_EXPORT_PRESET=slow
CLIPFORGE_CLIPPER_EXPORT_FPS=30

# Default share of the 1080x1920 canvas given to the facecam in gaming layouts.
CLIPFORGE_CLIPPER_FACE_PCT=0.35

# 0 = never auto-purge clipper project artifacts.
CLIPFORGE_CLIPPER_RETENTION_DAYS=0

# Use the learned ranker once it qualifies (>=40 reviewed clips AND it beats
# the heuristic on held-out NDCG@5). false pins scoring to the heuristic.
CLIPFORGE_CLIPPER_RANKER_ENABLED=true
